# Local/dev-only files — not needed by the deployed app.
#
# rsconnect's .rscignore only matches literal top-level entry names within
# the directory that contains it (no globs, no trailing slashes, no nested
# paths — see rsconnect:::ignoreBundleFiles / recursiveBundleFiles). A
# directory must be listed WITHOUT a trailing slash to be excluded, and a
# nested file needs its own .rscignore inside that subdirectory (see
# R/.rscignore and www/.rscignore) — "R/Global.R" here does nothing.
.claude
.git
.gitignore
.Rproj.user
.RData
.Rhistory
.Ruserdata
*.Rproj
README.md
CLAUDE.md

# Confirmed-unused leftover files (not sourced/referenced anywhere in the app).
report1.Rmd

# Dev/test example workbooks — not referenced by the app (the actual
# downloadable template lives in www/ and is bundled normally).
BOAM_case_study_upload.xlsx
BOAM_example_upload.xlsx
NET_GAIN_test_upload.xlsx
Net_Gain_Upload_Example.xlsx
NPBV_component_comparison.xlsx
